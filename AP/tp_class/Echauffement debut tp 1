class Tirelire: 
    def __init__(self,pièces:list=None):
        if pièces is None:
           pièces =[]
        self.pièces=pièces 

   
   
    def deposit(self,x):
        assert x>0
        self.pièces.append(x)

    def total(self):
        b=0
        for x in self.pièces:
            b+=x
        return b

    def __len__(self):
        c=0
        for x in self.pièces:
            c+=1
        return c
     
    
    def __repr__(self):
           return f"Tirelire({len(self.pièces)}coins , total= {})"

    
